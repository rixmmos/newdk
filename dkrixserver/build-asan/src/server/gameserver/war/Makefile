# target to generate assembly for a file
ZoneItemPosition.cpp.s:
	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/gameserver/war/CMakeFiles/War.dir/build.make src/server/gameserver/war/CMakeFiles/War.dir/ZoneItemPosition.cpp.s
.PHONY : ZoneItemPosition.cpp.s

