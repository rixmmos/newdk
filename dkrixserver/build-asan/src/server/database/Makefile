	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/database/CMakeFiles/Database.dir/build.make src/server/database/CMakeFiles/Database.dir/Statement.cpp.o
	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/database/CMakeFiles/GameServerDatabase.dir/build.make src/server/database/CMakeFiles/GameServerDatabase.dir/Statement.cpp.o
	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/database/CMakeFiles/LoginServerDatabase.dir/build.make src/server/database/CMakeFiles/LoginServerDatabase.dir/Statement.cpp.o
	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/database/CMakeFiles/SharedServerDatabase.dir/build.make src/server/database/CMakeFiles/SharedServerDatabase.dir/Statement.cpp.o
	cd /mnt/c/newdk/dkrixserver/build-asan && $(MAKE) $(MAKESILENT) -f src/server/database/CMakeFiles/UpdateServerDatabase.dir/build.make src/server/database/CMakeFiles/UpdateServerDatabase.dir/Statement.cpp.o
.PHONY : Statement.cpp.o

