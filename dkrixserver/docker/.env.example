# Docker stack credentials — reference copy.
#
#   cp .env.example .env      # then edit .env and set real values
#
# `.env` is gitignored and must never be committed. This file is tracked and
# must never contain a real password.
#
# Compose reads `.env` from this directory (dkrixserver/docker/) automatically.
# Every variable here is mandatory: `docker compose up` / `build` aborts with a
# pointer back to this file if one is unset.

# ── MySQL superuser ───────────────────────────────────────────────────────────
# Used only by the odk-mysql container's own bootstrap. The servers never use it.
MYSQL_ROOT_PASSWORD=change-me-root

# ── Application account ───────────────────────────────────────────────────────
# The MySQL image creates the `elcastle` account from MYSQL_USER/MYSQL_PASSWORD,
# and initdb/a-setup.sql grants it DARKEDEN + USERINFO. The three DKRIX_* names
# below are what docker/conf/*.conf.template reference via ${...} placeholders
# (DB_PASSWORD, UI_DB_PASSWORD, DIST_DB_PASSWORD).
#
# In this stack all three roles are the same `elcastle` account on the same
# odk-mysql host, so THE THREE VALUES MUST BE IDENTICAL and must equal the
# password the image created the account with (compose wires DKRIX_DB_PASSWORD
# into MYSQL_PASSWORD for exactly that reason).
DKRIX_DB_PASSWORD=change-me-app
DKRIX_UI_DB_PASSWORD=change-me-app
DKRIX_DIST_DB_PASSWORD=change-me-app

# ── One more place the same password lives ────────────────────────────────────
# There is a FOURTH copy that no environment variable reaches: the `WorldDBInfo`
# table, seeded as data by initdb/DARKEDEN.sql, whose Host/User/Password columns
# the servers read at startup (src/server/database/DatabaseManager.cpp:108-134)
# to open the per-world connection. The seeded row carries the old throwaway
# value `elca110`. If you set DKRIX_DB_PASSWORD to anything else, the servers
# will connect to the default DB fine and then fail on the world connection
# until you also run, once, against the running odk-mysql container:
#
#     UPDATE DARKEDEN.WorldDBInfo SET Password = '<the value you chose>';
#
# Leaving DKRIX_DB_PASSWORD as `elca110` keeps the seed consistent, but that
# value is published and burned: acceptable only for a throwaway local stack
# that no network can reach.
